{
  "schemaVersion": 1,
  "id": "brewery",
  "version": "${version}",
  "name": "[Let's Do] Brewery",
  "description": "Ozapft is! Brau Bier, beiss in a Bretzn – willkomme zum Braufescht!",
  "authors": [
    "satisfy"
  ],
  "credits": [
    "MissLilitu, CR-055"
  ],
  "contact": {
    "issues": "https://github.com/satisfyu/Let-s-Do-Hub",
    "sources": "https://github.com/satisfyu/Brewery"
  },
  "license": "Custom",
  "icon": "pack.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "net.satisfy.brewery.fabric.BreweryFabric"
    ],
    "client": [
      "net.satisfy.brewery.fabric.client.BreweryClientFabric"
    ],
    "rei_client": [
      "net.satisfy.brewery.fabric.core.rei.BreweryREIClientPluginFabric"
    ],
    "jei_mod_plugin": [
      "net.satisfy.brewery.core.compat.jei.BreweryJEIClientPlugin"
    ],
    "modmenu": [
      "net.satisfy.brewery.fabric.core.config.ModMenu"
    ]
  },
  "mixins": [
    "brewery-common.mixins.json"
  ],
  "depends": {
    "fabric": "*",
    "minecraft": ">=1.20.1",
    "architectury": ">=6.5.82",
    "farm_and_charm": ">=1.0.6"
  }
}